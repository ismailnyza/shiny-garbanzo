# Server
APP_ENV=development
PORT=8080
FRONTEND_BASE_URL=https://yourdomain.com

# Database
# Prefer DATABASE_URL for hosted Postgres. Leave it empty when using the DB_* fields below.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=qr_restaurant
DB_SSL_MODE=disable

# JWT
JWT_SECRET=your-256-bit-secret-here-change-in-production
JWT_EXPIRY_HOURS=24
SESSION_TTL_HOURS=8

# Bcrypt
BCRYPT_COST=12

# Rate Limiting
RATE_LIMIT_PUBLIC=60
RATE_LIMIT_ADMIN=120

# Cloudflare R2
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_key
R2_SECRET_ACCESS_KEY=your_secret
R2_BUCKET_NAME=qr-restaurant
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# Migrations
MIGRATE_PATH=file://migrations
